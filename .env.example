# KREDIT — env example (copy to .env)
DATABASE_URL=postgres://kredit:kredit@localhost:5432/kredit
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kredit-docs
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
JWT_SECRET=change-me-64-chars-min
JWT_EXPIRES=15m
REFRESH_EXPIRES=7d
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Providers (feature-flagged)
KYC_PROVIDER=onfido
KYC_API_KEY=
