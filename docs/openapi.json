  "info": {
    "title": "KREDIT API",
    "description": "Plateforme Europeenne de Credit & Investissement — Belgique EUR — FR/EN/NL/DE — Simulation ≠ offre, decision humaine, audit immuable",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Auth",
      "description": ""
    },
    {
      "name": "Customer",
      "description": ""
    },
    {
      "name": "Credit",
      "description": ""
    },
    {
      "name": "Investments",
      "description": ""
    },
    {
      "name": "Payments",
      "description": ""
    },
    {
      "name": "Notifications",
      "description": ""
    },
    {
      "name": "Admin",
      "description": ""
    },
    {
      "name": "Super Admin",
      "description": ""
    }
  ],
  "servers": [
    {
      "url": "https://api.kredit.be"
    },
    {
      "url": "http://localhost:4000"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "idempotency": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Idempotency-Key"
      },
      "requestId": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Request-Id"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "alex@kredit.be"
          },
          "password": {
            "type": "string",
            "example": "Customer123!"
          },
          "locale": {
            "type": "string",
            "enum": [
              "fr",
              "en",
              "nl",
              "de"
            ]
          },
          "acceptGdpr": {
            "type": "boolean"
          }
        },
        "required": [
          "email",
          "password",
          "acceptGdpr"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "totp": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "VerifyPhoneDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "phone",
          "code"
        ]
      },
      "TwoFaDto": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "enable",
              "verify",
              "disable"
            ]
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "action"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "enum": [
              "fr",
              "en",
              "nl",
              "de"
            ]
          },
          "address": {
            "type": "object"
          }
        }
      },
      "SimDto": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "example": 15000
          },
          "termMonths": {
            "type": "number",
            "example": 48
          },
          "monthlyIncome": {
            "type": "number"
          },
          "monthlyCharges": {
            "type": "number"
          },
          "incomeType": {
            "type": "string",
            "enum": [
              "SALARY",
              "SELF_EMPLOYED",
              "PENSION"
            ]
          },
          "employmentStatus": {
            "type": "string",
            "enum": [
              "CDI",
              "CDD",
              "INDEPENDENT"
            ]
          },
          "loanPurpose": {
            "type": "string",
            "enum": [
              "VEHICLE",
              "WORKS",
              "CONSUMPTION"
            ]
          },
          "existingCreditsMonthly": {
            "type": "number"
          },
          "country": {
            "type": "string"
          },
          "productType": {
            "type": "string"
          },
          "birthDate": {
            "type": "string"
          }
        },
        "required": [
          "amount",
          "termMonths",
          "monthlyIncome",
          "monthlyCharges",
          "incomeType",
          "employmentStatus",
          "loanPurpose"
        ]
      },
      "AppDto": {
        "type": "object",
        "properties": {
          "simulationId": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "termMonths": {
            "type": "number"
          },
          "purpose": {
            "type": "string"
          },
          "productType": {
            "type": "string"
          },
          "country": {
            "type": "string"
          }
        },
        "required": [
          "simulationId",
          "amount",
          "termMonths",
          "productType",
          "country"
        ]
      },
      "SubscribeDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "idempotencyKey": {
            "type": "string"
          },
          "riskConfirm": {
            "type": "boolean"
          },
          "docsAck": {
            "type": "boolean"
          }
        },
        "required": [
          "productId",
          "amount",
          "idempotencyKey",
          "docsAck"
        ]
      },
      "CreatePaymentDto": {
        "type": "object",
        "properties": {
          "loanId": {
            "type": "string"
          },
          "installmentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "idempotencyKey": {
            "type": "string"
          }
        },
        "required": [
          "loanId",
          "amount",
          "idempotencyKey"
        ]
      },
      "RequestInfoDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "reason"
        ]
      },
      "ApproveDto": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string"
          }
        }
      },
      "ApproveExceptionDto": {
        "type": "object",
        "properties": {
          "exceptionReason": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "exceptionReason"
        ]
      },
      "RejectDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "reason"
        ]
      },
      "RuleDto": {
        "type": "object",
        "properties": {
          "product_type": {
            "type": "string"
          },
          "country_code": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "value": {
            "type": "object"
          },
          "is_hard": {
            "type": "boolean"
          }
        },
        "required": [
          "product_type",
          "country_code",
          "key",
          "value"
        ]
      },
      "RateRuleDto": {
        "type": "object",
        "properties": {
          "product_type": {
            "type": "string"
          },
          "country_code": {
            "type": "string"
          },
          "min_amount": {
            "type": "number"
          },
          "max_amount": {
            "type": "number"
          },
          "min_term": {
            "type": "number"
          },
          "max_term": {
            "type": "number"
          },
          "base_rate": {
            "type": "number"
          }
        },
        "required": [
          "product_type",
          "country_code",
          "min_amount",
          "max_amount",
          "min_term",
          "max_term",
          "base_rate"
        ]
      },
      "AdminDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "SUPER_ADMIN"
            ]
          },
          "tempPassword": {
            "type": "string"
          }
        },
        "required": [
          "email",
          "role",
          "tempPassword"
        ]
      }
    }
  }
}